---
import { allLocales } from '@/config'
import { getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { getPageInfo } from '@/utils/page'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
---

<Layout postTitle={currentUI.self}>
  <div class="uno-decorative-line" />
  <div class="heti">
    <h1 class="mb-8 text-2xl font-bold">{currentUI.self}</h1>
    <p>页面内容待补充</p>
  </div>
</Layout>
