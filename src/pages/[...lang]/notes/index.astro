---
import { getCollection, render } from 'astro:content'
import { allLocales } from '@/config'
import { getLangRouteParam } from '@/i18n/lang'
import NotesLayout from '@/layouts/NotesLayout.astro'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const allNotes = await getCollection('notes')
const sortedNotes = allNotes.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

// 默认显示第一条笔记
const firstNote = sortedNotes[0]
let Content = null
if (firstNote) {
  const rendered = await render(firstNote)
  Content = rendered.Content
}
---

<NotesLayout currentNote={firstNote}>
  {firstNote && Content
? (
    <article>
      <header class="note-header">
        <h1 class="note-title">{firstNote.data.title}</h1>
        <div class="note-meta">
          <time>
            {firstNote.data.date.toLocaleDateString('zh-CN', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              weekday: 'long',
            })}
          </time>
          {firstNote.data.mood && <span>心情: {firstNote.data.mood}</span>}
          {firstNote.data.weather && <span>天气: {firstNote.data.weather}</span>}
        </div>
      </header>

      <div class="note-content heti">
        <Content />
      </div>
    </article>
  )
: (
    <p>暂无笔记</p>
  )}
</NotesLayout>

<style>
  .note-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--secondary);
  }

  .note-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
    margin: 0 0 0.5rem 0;
  }

  .note-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--secondary);
  }

  .note-content {
    line-height: 1.8;
  }
</style>
