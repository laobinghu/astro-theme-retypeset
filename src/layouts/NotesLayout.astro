---
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { getPageInfo } from '@/utils/page'

interface Props {
  currentNote?: CollectionEntry<'notes'>
}

const { currentNote } = Astro.props
const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
const langPrefix = currentLang === 'zh' ? '' : `/${currentLang}`

const allNotes = await getCollection('notes')
const sortedNotes = allNotes.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

// Group notes by year for timeline
const notesByYear = new Map<number, CollectionEntry<'notes'>[]>()
for (const note of sortedNotes) {
  const year = note.data.date.getFullYear()
  if (!notesByYear.has(year)) {
    notesByYear.set(year, [])
  }
  notesByYear.get(year)!.push(note)
}

const years = Array.from(notesByYear.keys()).sort((a, b) => b - a)
---

<Layout postTitle={currentNote?.data.title ?? currentUI.notes}>
  <div class="notes-wrapper">
    <!-- 左侧时间轴 -->
    <nav class="notes-sidebar">
      <div class="sidebar-section">
        <div class="sidebar-label">{currentUI.notes}</div>
        <ul class="sidebar-list">
          {years.map(year => (
            <li class="sidebar-year">
              <span class="year-label">{year}</span>
              <ul class="year-notes">
                {notesByYear.get(year)!.map(note => (
                  <li class:list={['note-item', currentNote?.data.slug === note.data.slug && 'active']}>
                    <a href={`${langPrefix}/notes/${note.data.slug}/`}>
                      <span class="note-title">{note.data.title}</span>
                      <span class="note-date">{note.data.date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <!-- 内容区域 -->
    <main class="notes-main">
      <slot />
    </main>
  </div>
</Layout>

<script src="@/scripts/notes-navigation.js"></script>

<style>
  .notes-wrapper {
    display: flex;
    gap: 2rem;
  }

  .notes-sidebar {
    width: 220px;
    flex-shrink: 0;
    position: sticky;
    top: 2rem;
    height: fit-content;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }

  .sidebar-section {
    font-size: 0.875rem;
  }

  .sidebar-label {
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-year {
    margin-bottom: 1rem;
  }

  .year-label {
    font-weight: 600;
    color: var(--secondary);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
    display: block;
  }

  .year-notes {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .note-item {
    margin-bottom: 0.25rem;
  }

  .note-item a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.375rem 0.5rem;
    border-radius: 0.25rem;
    text-decoration: none;
    color: var(--secondary);
    transition: all 0.15s ease;
  }

  .note-item a:hover {
    background: var(--highlight);
    color: var(--primary);
  }

  .note-item.active a {
    background: var(--highlight);
    color: var(--primary);
    font-weight: 600;
  }

  .note-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }

  .note-date {
    font-size: 0.75rem;
    opacity: 0.7;
    margin-left: 0.5rem;
    flex-shrink: 0;
  }

  .notes-main {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 768px) {
    .notes-wrapper {
      flex-direction: column;
    }

    .notes-sidebar {
      width: 100%;
      position: static;
      max-height: none;
    }

    .year-notes {
      display: flex;
      overflow-x: auto;
      gap: 0.5rem;
      padding-bottom: 0.5rem;
    }

    .note-item {
      flex-shrink: 0;
    }

    .note-item a {
      white-space: nowrap;
    }

    .note-date {
      display: none;
    }
  }
</style>
